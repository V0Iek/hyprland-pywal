* {{
  monitor: "primary";
  
  font: "Fira Sans 12";

  text-color: {foreground};
  background-color: #00000000;
}}

window {{
  width: 35%;
  height: 60%;

  padding: 10px;

  background-color: {background}88;
  transparency: "real";
}}

entry {{
  placeholder: "Search 󰍉";

  margin: 0 0 15px 0;
}}

element {{
  margin: 5px;
  padding: 5px;

  border-radius: 5px;
}}

element selected {{
  background-color: {color0};
}}

element-text {{
  horizontal-align: 0.5;
  vertical-align: 0.5;
}}

element-icon {{
  size: 1.5em;
}}
